{
  "name": "lovelace-mycards",
  "version": "0.1.0",
  "description": "A suite of custom Lovelace cards for Home Assistant",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "watch": "vite build --watch --mode development",
    "dev": "npm run dev:up && npm run watch",
    "dev:up": "npm run build && docker compose -f dev/docker-compose.yml up -d && npm run dev:onboard && npm run dev:seed",
    "dev:onboard": "node dev/scripts/onboard.mjs",
    "dev:seed": "node dev/scripts/seed.mjs",
    "dev:down": "docker compose -f dev/docker-compose.yml down",
    "dev:logs": "docker compose -f dev/docker-compose.yml logs -f homeassistant",
    "dev:reset": "docker compose -f dev/docker-compose.yml down && rimraf \"dev/config/.storage\" \"dev/config/*.db*\" \"dev/config/*.log*\" \"dev/config/.cloud\" \"dev/config/deps\" \"dev/config/tts\" \"dev/config/blueprints\" \"dev/config/.uuid\" \"dev/config/automations.yaml\" \"dev/config/scenes.yaml\" \"dev/config/scripts.yaml\" \"dev/config/secrets.yaml\" \"dev/config/www\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "custom-card-helpers": "^2.0.0",
    "home-assistant-js-websocket": "^9.4.0",
    "lit": "^3.2.1",
    "memoize-one": "^6.0.0",
    "superstruct": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
